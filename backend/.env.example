# Copy to `.env` and fill in. Never commit the real `.env`.

# App
ENVIRONMENT=development

# Database — SQLAlchemy async URL (psycopg 3 driver).
# Leave empty until Postgres is provisioned; the app still boots and the
# health endpoint will report database "not_configured".
# Example: postgresql+psycopg://ai_cfo:ai_cfo@localhost:5432/ai_cfo
DATABASE_URL=

# Security (used from Phase 2)
JWT_SECRET=change-me-to-a-long-random-string

# LLM provider (used from Phase 7)
LLM_PROVIDER=openai
LLM_API_KEY=

# CORS — comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000
