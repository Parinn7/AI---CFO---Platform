# Copy to `.env` and fill in. Never commit the real `.env`.

# App
ENVIRONMENT=development

# Database — SQLAlchemy async URL (psycopg 3 driver). Hosted on Supabase.
# Leave empty until provisioned; the app still boots and the health endpoint
# reports database "not_configured".
#
# From the Supabase dashboard: Project Settings -> Database -> Connection string.
# Take the URI and replace the "postgresql://" scheme with "postgresql+psycopg://".
# Use the Direct connection or Session pooler for migrations (the Transaction
# pooler on port 6543 has prepared-statement caveats with psycopg 3).
# Example:
#   postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Security (used from Phase 2)
JWT_SECRET=change-me-to-a-long-random-string

# LLM provider — the AI CFO assistant (Phase 7.4, FR-6.4).
# `gemini` (Google AI Studio) or `none`. Leaving the key empty is fine: the
# assistant reports itself as not connected and replies with a placeholder
# instead of failing, so the rest of the app works without one.
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
# Any model the key can reach; `gemini-flash-latest` tracks the newest flash.
LLM_MODEL=gemini-3.8-flash

# Optional tuning — the defaults are in app/core/config.py.
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TEMPERATURE=0.2
# Thinking tokens come out of the output budget. -1 = dynamic; 0 (off) is only
# valid on flash models.
# LLM_THINKING_BUDGET=0

# CORS — comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Public base URL of the frontend — used to build password-reset links (Phase 2.4).
FRONTEND_BASE_URL=http://localhost:3000
